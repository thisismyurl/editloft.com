# Cloudflare Pages headers. Security baseline + cache policy.
# Cache: fonts never change under the same name, so they are immutable. The
# stylesheet, images and icons keep their filenames across edits, so they revalidate
# daily. Do NOT put a wildcard /assets/* rule above these: Pages merges matching
# rules, and a second Cache-Control value would be appended, not replaced.
# CSP note: pages carry inline application/ld+json (data, not executable JS). The only executable
# scripts are on /newsletter/: its own newsletter.js and Cloudflare Turnstile, which is why
# challenges.cloudflare.com is allowed for script-src and frame-src.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests

/assets/style.css
  Cache-Control: public, max-age=86400, must-revalidate

/assets/og-image.png
  Cache-Control: public, max-age=86400, must-revalidate

/assets/favicon.svg
  Cache-Control: public, max-age=86400, must-revalidate

/assets/apple-touch-icon.png
  Cache-Control: public, max-age=86400, must-revalidate

/assets/diagram-lineage.svg
  Cache-Control: public, max-age=86400, must-revalidate

/assets/screenshot-calendar.webp
  Cache-Control: public, max-age=86400, must-revalidate

/assets/screenshot-audit-trail.webp
  Cache-Control: public, max-age=86400, must-revalidate

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400, must-revalidate
